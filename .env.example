# Leave everything empty and the app still works: template draft + rule-based tidy-up.

# 1) Draft model: any OpenAI-compatible /chat/completions endpoint.
#    Local, free:  LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=qwen3:8b   (ollama pull qwen3:8b)
#    Hosted:       LLM_BASE_URL=https://router.huggingface.co/v1  LLM_API_KEY=hf_xxx  LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 2) Normalizer: open-source model that rewrites the draft into plain customer language.
#    Defaults to the LLM_* endpoint/key above; set these to use a different host.
#    Small models work well here: gemma3:4b, qwen3:4b (Ollama) or google/gemma-3-4b-it, Qwen/Qwen3-4B (HF).
NORMALIZER_MODEL=
NORMALIZER_BASE_URL=
NORMALIZER_API_KEY=

# 3) Database. Empty = local JSON file at data/db.json. Set both to use Supabase (run supabase/schema.sql first).
#    Service-role key is server-only; never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 4) Owner login. Required in production: 32+ random characters (e.g. openssl rand -hex 32).
SESSION_SECRET=

# 5) Email for verification and password-reset codes, sent over SMTP.
#    Empty SMTP_HOST in development = codes are printed in the server log instead of emailed.
#    Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=a 16-letter App Password
#           (Google Account → Security → 2-Step Verification → App passwords; your normal password won't work).
#    Outlook/Hotmail: smtp-mail.outlook.com, 587. Hosting mail (cPanel etc.): your host's SMTP details.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
#    EMAIL_FROM is optional (defaults to SMTP_USER). Gmail always sends from SMTP_USER anyway.

# 6) Super-admin (platform owner) panel at /superadmin. Comma-separated emails of verified accounts.
#    Never list the demo account here: its password is public in the README.
# Team admins with full access, comma-separated (e.g. you@gmail.com,teammate@gmail.com). Set their passwords in the admin panel → Team admins.
SUPER_ADMIN_EMAILS=

# 7) Where owners send plan payments (shown on their Account page). Leave a method empty to hide it.
PAYMENT_ACCOUNT_TITLE=
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_EASYPAISA=
PAYMENT_JAZZCASH=
